{
  "name": "steamfx",
  "productName": "SteamFX",
  "version": "0.0.0-dev",
  "description": "Tray app that converts prices in the Steam client to your currency.",
  "author": "Steam FX contributors",
  "license": "MIT",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "prepare-shared": "node scripts/prepare-shared.js",
    "start": "npm run prepare-shared && electron .",
    "test": "npm run prepare-shared && node --test \"test/*.test.js\"",
    "dist": "node scripts/dist.js"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.pozii.steamfx",
    "productName": "SteamFX",
    "copyright": "Copyright (c) 2026 Steam FX contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      },
      {
        "from": "build/tray@2x.png",
        "to": "tray@2x.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "SteamFX",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "SteamFX-Setup-${version}.exe",
      "differentialPackage": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "pozii",
        "repo": "SteamFX"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
